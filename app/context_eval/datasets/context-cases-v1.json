    {"id": "provider-timeout", "fault": "timeout", "riskLevel": "LOW", "expectedOutcome": "cloud_fallback"},
    {"id": "structured-output-invalid", "fault": "invalid_json", "riskLevel": "LOW", "expectedOutcome": "deterministic_fallback"},
    {"id": "stream-disconnected", "fault": "stream_interrupted", "riskLevel": "LOW", "expectedOutcome": "recovered"},
    {"id": "memory-cache-down", "fault": "redis_unavailable", "riskLevel": "LOW", "expectedOutcome": "degraded"},
