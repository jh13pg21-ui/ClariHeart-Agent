{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_candidate_v2",
  "type": "array",
  "maxItems": 12,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["type", "name", "description", "body", "evidenceMessageIds"],
    "properties": {
      "type": {"type": "string", "enum": ["PROFILE", "PREFERENCE", "GOAL", "CONSTRAINT", "SUPPORT"]},
      "name": {"type": "string", "minLength": 1, "maxLength": 120},
      "description": {"type": "string", "maxLength": 300},
      "body": {"type": "string", "minLength": 1, "maxLength": 1200},
      "confidence": {"type": "number", "minimum": 0, "maximum": 1},
      "evidenceMessageIds": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
    }
  }
}
