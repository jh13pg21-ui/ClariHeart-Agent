{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory_consolidation_v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["decisions"],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "sourceMemoryIds"],
        "properties": {
          "action": {"type": "string", "enum": ["KEEP", "MERGE", "SUPERSEDE", "EXPIRE"]},
          "sourceMemoryIds": {"type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 64}},
          "mergedMemory": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "memoryKey", "name", "description", "body", "reason"],
            "properties": {
              "type": {"type": "string", "enum": ["PROFILE", "PREFERENCE", "SUPPORT", "CONTEXT", "GOAL", "CONSTRAINT"]},
              "memoryKey": {"type": "string", "minLength": 1, "maxLength": 191, "pattern": "^[a-z0-9_.-]+$"},
              "name": {"type": "string", "minLength": 1, "maxLength": 128},
              "description": {"type": "string", "maxLength": 256},
              "body": {"type": "string", "minLength": 4, "maxLength": 1000},
              "reason": {"type": "string", "maxLength": 1000}
            }
          }
        }
      }
    }
  }
}
