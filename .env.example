AGENT_FRAMEWORK=event_driven_multi_agent
AGENT_TASK_TIMEOUT_SECONDS=70
AGENT_TASK_MAX_ATTEMPTS=2
AGENT_RETRY_BASE_SECONDS=0.2
AGENT_RETRY_MAX_SECONDS=2
AGENT_RETRY_JITTER_RATIO=0.25
AI_PROVIDER=mock
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_NAME=mindbridge-qwen2.5-7b-ft:latest
FINETUNED_MODEL_DIR=models/mindbridge-qwen2.5-7b-ft
FINETUNED_MODEL_FILE=mindbridge-qwen2.5-7b-ft-q4_k_m.gguf
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DATABASE_URL=mysql+pymysql://mindbridge:mindbridge@127.0.0.1:3306/mindbridge?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
RABBITMQ_URL=amqp://mindbridge:mindbridge@127.0.0.1:5672//
RABBITMQ_EXCHANGE=mindbridge.events
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_GENERAL_QUEUE=mindbridge.general
CELERY_ALERT_QUEUE=mindbridge.alert
OUTBOX_PUBLISHER_BATCH_SIZE=50
OUTBOX_PUBLISHER_POLL_SECONDS=1
OUTBOX_PUBLISHER_MAX_ATTEMPTS=10
REDIS_MEMORY_TTL_SECONDS=86400
REDIS_MEMORY_MAX_MESSAGES=40
REDIS_SOCKET_TIMEOUT_SECONDS=2
LONG_TERM_MEMORY_ENABLED=true
LONG_TERM_MEMORY_MAX_ITEMS=200
LONG_TERM_MEMORY_RELEVANT_ITEMS=5
LONG_TERM_MEMORY_EXTRACT_MESSAGES=10
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
KNOWLEDGE_TOP_K=4
KNOWLEDGE_CANDIDATE_K=16
KNOWLEDGE_HYBRID_VECTOR_WEIGHT=0.65
KNOWLEDGE_HYBRID_BM25_WEIGHT=0.35
KNOWLEDGE_RERANK_ENABLED=true
KNOWLEDGE_VECTOR_ENABLED=true
KNOWLEDGE_VECTOR_REQUIRED=false
CHROMA_PERSIST_DIR=data/chroma
CHROMA_COLLECTION_NAME=mindbridge_knowledge
CHROMA_SNAPSHOT_DIR=data/chroma-snapshots
CHROMA_SNAPSHOT_KEEP=5
EMBEDDING_TIMEOUT_SECONDS=30
RAG_EVAL_ENABLED=false
RAG_EVAL_EXIT_AFTER_RUN=false
RISK_EVAL_DATASET=app/risk_eval/mindbridge-risk-eval.json
RISK_EVAL_OUTPUT=target/risk-eval-report.json
TOOL_TASK_MAX_ATTEMPTS=5
MCP_ALLOWED_ACTORS=admin,counselor
ALERT_EMAIL_RATE_LIMIT_PER_MINUTE=30
ALERT_EMAIL_DELIVERY_MODE=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_SUBJECT_PREFIX=[MindBridge 高风险预警]
PRIVACY_STORE_ORIGINAL_INPUT=false
PRIVACY_REQUIRE_ENCRYPTION_AT_REST=false
# 使用 Fernet.generate_key() 生成；生产环境建议配置，并设上面的 REQUIRE 为 true。
SENSITIVE_DATA_ENCRYPTION_KEY=
PRIVACY_RETENTION_ENABLED=true
CHAT_DATA_RETENTION_DAYS=365
RISK_DATA_RETENTION_DAYS=1095
